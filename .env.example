# Copy this to `.env` and fill in the key.
#
#     cp .env.example .env
#
# The app looks for `.env` in this folder first, then one level above it, so
# a key kept outside the repo is picked up without copying it in. Never
# commit the real file — .gitignore already excludes it.

# The course gateway. This is the one the project uses.
PORTKEY_API_KEY=pk-your-key-here

# Optional fallback, used only if PORTKEY_API_KEY is empty.
OPENAI_API_KEY=

# Only change this if you are pointing at a different gateway.
AI_BASE_URL=https://api.portkey.ai/v1

# Optional. Sets the four demo accounts' password on first run.
# Defaults to "statestreet" if unset.
HOUSE_DEMO_PASSWORD=
